# .env.example — copy to .env and fill in
APP_CONFIG=dev
APP_PORT=5000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Read by docker-compose.yml to configure the Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=triage
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/triage
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/triage_test